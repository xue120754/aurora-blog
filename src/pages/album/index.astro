---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import PageTitle from "@/components/common/PageTitle.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { formatDateI18n } from "@/utils/date-utils";

// 2026-09-30 改版：整页变成「一整面照片墙」（所有相册的照片拆开铺满整个内容区），
// 顶部一条细线筛选（搜索 / 相册 / 标签），点照片开灯箱。
// 单相册页 /album/<id>/ 已删除；所有照片都走图床（imgbedFolder），客户端并行拉取。

const albums = (await getCollection("album"))
	.filter((a) => import.meta.env.PROD === false || a.data.draft !== true)
	.sort(
		(a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
	);

const imgbedUrl = import.meta.env.PUBLIC_IMAGEBED_URL || "";
const imgbedToken = import.meta.env.PUBLIC_IMAGEBED_API_TOKEN || "";

// 给前端：每个相册的元数据（照片由前端去图床拉）
const albumMeta = albums.map((a) => ({
	id: a.id,
	title: a.data.title,
	subtitle: a.data.subtitle || "",
	date: new Date(a.data.date).toISOString().slice(0, 10),
	dateText: formatDateI18n(new Date(a.data.date)),
	location: a.data.location || "",
	tags: a.data.tags || [],
	folder: a.data.imgbedFolder || "",
}));

const tagCounts = new Map<string, number>();
for (const a of albums) {
	for (const t of a.data.tags || [])
		tagCounts.set(t, (tagCounts.get(t) || 0) + 1);
}
const tags = [...tagCounts.entries()]
	.sort((x, y) => y[1] - x[1] || x[0].localeCompare(y[0], "zh-CN"))
	.map(([name, count]) => ({ name, count }));

const albumCount = albums.length;
---

<MainGridLayout
	title="相册"
	description="所有相册的照片都在这一面墙上"
>
	<div class="flex w-full rounded-(--radius-large) overflow-clip relative min-h-32">
		<div class="card-base z-10 px-4 py-6 md:px-9 relative w-full">
			<div class="mb-6">
				<PageTitle title="相册" eyebrow="Album" description="所有相册的照片都拆开铺在这一面墙上" />
			</div>

			<!-- 顶部筛选条：细线语言、无底色块；选中靠主题色下划线（不是胶囊） -->
			<div class="alb-bar" id="alb-bar">
				<div class="alb-bar__row">
					<label class="alb-search">
						<Icon name="material-symbols:search-rounded" is:inline class="text-[1.05rem]" />
						<input type="search" placeholder="搜索照片 / 相册 / 地点…" aria-label="搜索" id="alb-search" />
						<button type="button" class="alb-search__clear" id="alb-search-clear" hidden aria-label="清空搜索">
							<Icon name="material-symbols:close-rounded" is:inline />
						</button>
					</label>
					<span class="alb-count" id="alb-count">{albumCount} 个相册</span>
					<button type="button" class="alb-clear" id="alb-clear" hidden>清空</button>
				</div>
				<div class="alb-bar__row alb-bar__row--tabs">
					<div class="alb-tabs" id="alb-tabs" role="group" aria-label="按相册筛选">
						<button type="button" class="alb-tab is-active" data-album-id="">全部</button>
						{
							albumMeta.map((a) => (
								<button type="button" class="alb-tab" data-album-id={a.id}>
									{a.title}
								</button>
							))
						}
					</div>
				</div>
				<!-- 本地上传仅开发环境可见：公开页面只保留查看权限 -->
				{import.meta.env.DEV && (
					<div class="alb-bar__row alb-bar__row--upload">
						<button type="button" class="alb-upload" id="alb-upload-btn">
							<Icon name="material-symbols:add-rounded" is:inline />
							<span>上传照片</span>
						</button>
						<input id="alb-upload-input" type="file" accept="image/*" multiple hidden />
						<button type="button" class="alb-upload alb-export" id="alb-export-btn" hidden>
							<Icon name="material-symbols:download-rounded" is:inline />
							<span>导出</span>
						</button>
						<label class="alb-upload-tags">
							<span>标签</span>
							<input id="alb-upload-tags" type="text" placeholder="可选，逗号分隔" aria-label="上传标签" />
						</label>
						<span class="alb-upload-status" id="alb-upload-status" role="status" aria-live="polite"></span>
					</div>
				)}
			</div>

			<!-- 相册元数据：脚本从这里读取相册列表（不再用 define:vars 传 ALBUMS） -->
			<script type="application/json" id="album-meta" set:html={JSON.stringify(albumMeta)}></script>

			<!-- 照片墙：CSS columns 瀑布流，照片由脚本铺进来 -->
			<div class="alb-wall" id="alb-wall" data-url={imgbedUrl} data-token={imgbedToken}>
				<div class="alb-loading" id="alb-loading">
					<div class="alb-spinner"></div>
					<span id="alb-status">正在从图床加载照片…</span>
				</div>
			</div>
			<p class="alb-empty" id="alb-empty" hidden>没有符合条件的内容</p>
		</div>
	</div>

	<!-- 灯箱（自研，无第三方库）：跨整面墙切换 -->
	<div class="lightbox" id="lightbox" role="dialog" aria-label="图片查看器">
		<div class="lightbox-backdrop" id="lightbox-backdrop"></div>
		<button class="lightbox-close" id="lightbox-close" aria-label="关闭">
			<Icon name="material-symbols:close-rounded" is:inline />
		</button>
		<button class="lightbox-nav lightbox-prev" id="lightbox-prev" aria-label="上一张">
			<Icon name="material-symbols:chevron-left-rounded" is:inline />
		</button>
		<button class="lightbox-nav lightbox-next" id="lightbox-next" aria-label="下一张">
			<Icon name="material-symbols:chevron-right-rounded" is:inline />
		</button>
		<div class="lightbox-img-wrap" id="lightbox-img-wrap">
			<img id="lightbox-img" src="" alt="" />
			<div class="lightbox-meta" id="lightbox-meta"></div>
		</div>
		<div class="lightbox-counter" id="lightbox-counter"></div>
	</div>

	<script>
	import {
		buildFrontmatter,
		downloadPublishBundle,
		imageExtension,
		sanitizeFileName,
		toDateOnly,
	} from "@/utils/publish-export";
	import {
		createLocalId,
		listLocalMoments,
		listLocalPhotos,
		saveLocalPhoto,
		type LocalMoment,
		type LocalPhoto,
	} from "@/utils/social-store";

	interface AlbumMeta {
		id: string;
		title: string;
		subtitle: string;
		date: string;
		dateText: string;
		location: string;
		tags: string[];
		folder: string;
	}

	interface AlbumFile {
		name: string;
		metadata?: { FileType?: string };
	}

	/** 照片墙上的统一条目：远端图床 / 本地上传 / 说说图片 */
	interface PhotoItem {
		src: string;
		albumId: string;
		albumTitle: string;
		date: string;
		dateText: string;
		location: string;
		tags: string[];
		search: string;
		meta: string;
	}

	/** 当前页面实例的监听解绑控制器 */
	let abort: AbortController | null = null;
	/** 本地照片 / 说说图片的 Object URL，重新初始化时统一释放 */
	let objectUrls: string[] = [];

	function releaseObjectUrls() {
		objectUrls.forEach((url) => URL.revokeObjectURL(url));
		objectUrls = [];
	}

	function pad2(value: number): string {
		return String(value).padStart(2, "0");
	}

	function formatDay(ts: number): string {
		const d = new Date(ts);
		return `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}`;
	}

	function isImageFile(file: File): boolean {
		return file.type.startsWith("image/") || /\.(png|jpe?g|gif|webp|avif|svg|bmp)$/i.test(file.name);
	}

	function parseTags(raw: string): string[] {
		return Array.from(
			new Set(
				raw
					.split(/[,，、\s]+/)
					.map((tag) => tag.replace(/^#+/, "").trim())
					.filter(Boolean),
			),
		);
	}

	function readAlbumMeta(): AlbumMeta[] {
		const raw = document.getElementById("album-meta")?.textContent;
		if (!raw) return [];
		try {
			const parsed: unknown = JSON.parse(raw);
			return Array.isArray(parsed) ? (parsed as AlbumMeta[]) : [];
		} catch {
			return [];
		}
	}

	function initAlbumPage() {
		abort?.abort();
		const bed = document.getElementById("alb-wall");
		if (!bed) {
			abort = null;
			releaseObjectUrls();
			return;
		}

		abort = new AbortController();
		const { signal } = abort;
		releaseObjectUrls();

		const albums = readAlbumMeta();
		const bedUrl = bed.getAttribute("data-url") || "";
		const bedToken = bed.getAttribute("data-token") || "";
		const wall = bed;
		const statusEl = document.getElementById("alb-status");
		const emptyEl = document.getElementById("alb-empty");
		const countEl = document.getElementById("alb-count");
		const searchInput = document.getElementById("alb-search") as HTMLInputElement | null;
		const searchClear = document.getElementById("alb-search-clear");
		const clearBtn = document.getElementById("alb-clear");
		const tabsEl = document.getElementById("alb-tabs");
		const uploadBtn = document.getElementById("alb-upload-btn");
		const uploadInput = document.getElementById("alb-upload-input") as HTMLInputElement | null;
		const uploadTags = document.getElementById("alb-upload-tags") as HTMLInputElement | null;
		const uploadStatus = document.getElementById("alb-upload-status");
		const exportBtn = document.getElementById("alb-export-btn");

		const state = { q: "", album: "", tag: "" };
		/** 三组照片分开存，渲染顺序：本地上传 → 说说图片 → 远端（日期倒序） */
		let localPhotos: PhotoItem[] = [];
		/** 本地上传的原始记录（含 Blob / 标签 / 日期），导出用；不含说说图片 */
		let localItems: LocalPhoto[] = [];
		let momentPhotos: PhotoItem[] = [];
		let remotePhotos: PhotoItem[] = [];
		let photos: PhotoItem[] = [];
		/** 当前可见（筛选后）的照片，灯箱按它切换 */
		let visible: HTMLButtonElement[] = [];
		let uploadTimer = 0;

		function setStatus(message: string) {
			if (statusEl) statusEl.textContent = message;
		}

		function note(message: string) {
			if (!uploadStatus) return;
			uploadStatus.textContent = message;
			window.clearTimeout(uploadTimer);
			uploadTimer = window.setTimeout(() => {
				uploadStatus.textContent = "";
			}, 2400);
		}

		function finishLoading() {
			document.getElementById("alb-loading")?.remove();
		}

		/* ---------- 本地数据：本地上传照片 + 说说图片 ---------- */
		function mapLocalPhotos(items: LocalPhoto[]): PhotoItem[] {
			return items.map((photo) => {
				const url = URL.createObjectURL(photo.blob);
				objectUrls.push(url);
				const date = formatDay(photo.createdAt);
				const tags = photo.tags ?? [];
				return {
					src: url,
					albumId: "local",
					albumTitle: "本地上传",
					date,
					dateText: date,
					location: "",
					tags,
					search: ["本地上传", ...tags].join(" ").toLowerCase(),
					meta: ["本地上传", date].join(" · "),
				};
			});
		}

		function mapMomentPhotos(items: LocalMoment[]): PhotoItem[] {
			const list: PhotoItem[] = [];
			items.forEach((moment) => {
				const date = formatDay(moment.createdAt);
				const tags = moment.tags ?? [];
				moment.images.forEach((blob) => {
					const url = URL.createObjectURL(blob);
					objectUrls.push(url);
					list.push({
						src: url,
						albumId: "moments",
						albumTitle: "说说",
						date,
						dateText: date,
						location: "",
						tags,
						search: ["说说", ...tags].join(" ").toLowerCase(),
						meta: ["说说", date].join(" · "),
					});
				});
			});
			return list;
		}

		async function loadLocalItems(): Promise<boolean> {
			let locals: LocalPhoto[] = [];
			let moments: LocalMoment[] = [];
			try {
				locals = await listLocalPhotos();
			} catch {
				locals = [];
			}
			try {
				moments = await listLocalMoments();
			} catch {
				moments = [];
			}
			if (signal.aborted) return false;
			localItems = locals;
			localPhotos = mapLocalPhotos(locals);
			momentPhotos = mapMomentPhotos(moments);
			return true;
		}

		/* ---------- 拉图床：每个相册一个文件夹，并行 ---------- */
		async function listFolder(folder: string): Promise<AlbumFile[]> {
			let out: AlbumFile[] = [];
			let start = 0;
			while (true) {
				const response = await fetch(
					`${bedUrl}/api/manage/list?dir=${encodeURIComponent(folder)}&start=${start}&count=100`,
					{ headers: { Authorization: `Bearer ${bedToken}` }, signal },
				);
				if (!response.ok) throw new Error(`HTTP ${response.status}`);
				const data = (await response.json()) as { files?: AlbumFile[] };
				const files = (data.files ?? []).filter((file) =>
					file.metadata?.FileType?.startsWith("image/"),
				);
				out = out.concat(files);
				setStatus(`正在从图床加载照片… ${out.length} 张`);
				if (!data.files || data.files.length < 100) break;
				start += 100;
			}
			return out;
		}

		async function loadRemoteItems() {
			const lists = await Promise.all(
				albums
					.filter((album) => album.folder)
					.map(async (album) => {
						try {
							const files = await listFolder(album.folder);
							const tags = album.tags ?? [];
							return files.map(
								(file) =>
									({
										src: `${bedUrl}/file/${file.name}`,
										albumId: album.id,
										albumTitle: album.title,
										date: album.date,
										dateText: album.dateText,
										location: album.location,
										tags,
										search: [album.title, album.location, tags.join(" ")]
											.join(" ")
											.toLowerCase(),
										meta: [album.title, album.dateText || album.date, album.location]
											.filter(Boolean)
											.join(" · "),
									}) satisfies PhotoItem,
							);
						} catch {
							return [] as PhotoItem[];
						}
					}),
			);
			if (signal.aborted) return;
			remotePhotos = [];
			lists.forEach((list) => {
				remotePhotos = remotePhotos.concat(list);
			});
			remotePhotos.sort((x, y) => (x.date < y.date ? 1 : x.date > y.date ? -1 : 0));
		}

		/* ---------- 相册 tab（动态补「本地上传」「说说」） ---------- */
		function findTab(id: string): HTMLButtonElement | null {
			return tabsEl?.querySelector<HTMLButtonElement>(`[data-album-id="${id}"]`) ?? null;
		}

		function ensureTab(id: string, label: string) {
			if (!tabsEl || findTab(id)) return;
			const btn = document.createElement("button");
			btn.type = "button";
			btn.className = "alb-tab";
			btn.setAttribute("data-album-id", id);
			btn.textContent = label;
			tabsEl.appendChild(btn);
		}

		function syncTabs() {
			document.querySelectorAll<HTMLButtonElement>(".alb-tab[data-album-id]").forEach((btn) => {
				btn.classList.toggle(
					"is-active",
					(btn.getAttribute("data-album-id") || "") === state.album,
				);
			});
			document.querySelectorAll<HTMLButtonElement>(".alb-tab[data-album-tag]").forEach((btn) => {
				btn.classList.toggle(
					"is-active",
					(btn.getAttribute("data-album-tag") || "") === state.tag,
				);
			});
		}

		function syncDynamicTabs() {
			if (exportBtn) exportBtn.hidden = localPhotos.length === 0;
			if (localPhotos.length > 0) ensureTab("local", "本地上传");
			else findTab("local")?.remove();
			if (momentPhotos.length > 0) ensureTab("moments", "说说");
			else findTab("moments")?.remove();
			if (state.album === "local" && localPhotos.length === 0) state.album = "";
			if (state.album === "moments" && momentPhotos.length === 0) state.album = "";
			syncTabs();
		}

		/* ---------- 渲染 ---------- */
		function itemEl(photo: PhotoItem, index: number): HTMLButtonElement {
			const btn = document.createElement("button");
			btn.type = "button";
			btn.className = "alb-photo";
			btn.setAttribute("data-album-id", photo.albumId);
			btn.setAttribute("data-album-tag", photo.tags.join(","));
			btn.setAttribute("data-search", photo.search);
			btn.setAttribute("data-index", String(index));
			btn.setAttribute("data-meta", photo.meta);
			const img = document.createElement("img");
			img.loading = "lazy";
			img.decoding = "async";
			img.alt = photo.albumTitle || "";
			img.src = photo.src;
			btn.appendChild(img);
			btn.addEventListener("click", () => openLightbox(btn));
			return btn;
		}

		function render() {
			wall.querySelectorAll(".alb-photo").forEach((el) => el.remove());
			const fragment = document.createDocumentFragment();
			photos.forEach((photo, index) => fragment.appendChild(itemEl(photo, index)));
			wall.appendChild(fragment);
			applyFilters();
		}

		/* ---------- 筛选 ---------- */
		function match(el: Element): boolean {
			if (state.album && el.getAttribute("data-album-id") !== state.album) return false;
			if (state.tag && (el.getAttribute("data-album-tag") || "").split(",").indexOf(state.tag) < 0)
				return false;
			if (state.q && (el.getAttribute("data-search") || "").indexOf(state.q) < 0) return false;
			return true;
		}

		function applyFilters() {
			const els = Array.from(wall.querySelectorAll<HTMLButtonElement>(".alb-photo"));
			visible = [];
			els.forEach((el) => {
				const ok = match(el);
				el.classList.toggle("is-hide", !ok);
				if (ok) visible.push(el);
			});
			const filtering = !!(state.q || state.album || state.tag);
			if (countEl) {
				countEl.textContent = filtering
					? `已筛 ${visible.length} 张`
					: `${photos.length} 张照片`;
			}
			if (clearBtn) clearBtn.hidden = !filtering;
			if (emptyEl) emptyEl.hidden = !(filtering && visible.length === 0);
		}

		function syncSearchClear() {
			if (searchClear && searchInput) searchClear.hidden = !searchInput.value;
		}

		/* ---------- 搜索 / 筛选 / 清空 ---------- */
		let searchTimer = 0;
		searchInput?.addEventListener(
			"input",
			() => {
				syncSearchClear();
				window.clearTimeout(searchTimer);
				searchTimer = window.setTimeout(() => {
					state.q = (searchInput?.value || "").trim().toLowerCase();
					applyFilters();
				}, 150);
			},
			{ signal },
		);
		searchClear?.addEventListener(
			"click",
			() => {
				if (searchInput) searchInput.value = "";
				state.q = "";
				syncSearchClear();
				applyFilters();
			},
			{ signal },
		);
		/* 事件委托：静态 tab 与动态补的 tab 都走这里 */
		tabsEl?.addEventListener(
			"click",
			(event) => {
				const target = event.target as HTMLElement;
				const albumBtn = target.closest<HTMLButtonElement>("[data-album-id]");
				if (albumBtn) {
					const id = albumBtn.getAttribute("data-album-id") || "";
					state.album = state.album === id ? "" : id;
					syncTabs();
					applyFilters();
					return;
				}
				const tagBtn = target.closest<HTMLButtonElement>("[data-album-tag]");
				if (tagBtn) {
					const tag = tagBtn.getAttribute("data-album-tag") || "";
					state.tag = state.tag === tag ? "" : tag;
					syncTabs();
					applyFilters();
				}
			},
			{ signal },
		);
		clearBtn?.addEventListener(
			"click",
			() => {
				state.q = "";
				state.album = "";
				state.tag = "";
				if (searchInput) searchInput.value = "";
				syncSearchClear();
				syncTabs();
				applyFilters();
			},
			{ signal },
		);

		/* ---------- 灯箱 ---------- */
		const lb = document.getElementById("lightbox");
		const lbImg = document.getElementById("lightbox-img") as HTMLImageElement | null;
		const lbMeta = document.getElementById("lightbox-meta");
		const lbCounter = document.getElementById("lightbox-counter");
		let current = -1;

		function openLightbox(el: HTMLButtonElement) {
			current = visible.indexOf(el);
			if (current < 0) return;
			showCurrent();
			lb?.classList.add("is-open");
			document.documentElement.style.overflow = "hidden";
		}

		function closeLightbox() {
			lb?.classList.remove("is-open");
			document.documentElement.style.overflow = "";
		}

		function showCurrent() {
			const el = visible[current];
			if (!el || !lbImg) return;
			const img = el.querySelector("img");
			lbImg.src = img ? img.src : "";
			if (lbMeta) lbMeta.textContent = el.getAttribute("data-meta") || "";
			if (lbCounter) lbCounter.textContent = `${current + 1} / ${visible.length}`;
		}

		function step(delta: number) {
			if (!visible.length) return;
			current = (current + delta + visible.length) % visible.length;
			showCurrent();
		}

		const lbClose = document.getElementById("lightbox-close");
		const lbPrev = document.getElementById("lightbox-prev");
		const lbNext = document.getElementById("lightbox-next");
		const lbBackdrop = document.getElementById("lightbox-backdrop");
		lbClose?.addEventListener("click", closeLightbox, { signal });
		lbBackdrop?.addEventListener("click", closeLightbox, { signal });
		lbPrev?.addEventListener("click", () => step(-1), { signal });
		lbNext?.addEventListener("click", () => step(1), { signal });
		document.addEventListener(
			"keydown",
			(event) => {
				if (!lb?.classList.contains("is-open")) return;
				if (event.key === "Escape") closeLightbox();
				else if (event.key === "ArrowLeft") step(-1);
				else if (event.key === "ArrowRight") step(1);
			},
			{ signal },
		);
		let touchStartX: number | null = null;
		lb?.addEventListener(
			"touchstart",
			(event) => {
				touchStartX = event.touches[0]?.clientX ?? null;
			},
			{ passive: true, signal },
		);
		lb?.addEventListener(
			"touchend",
			(event) => {
				if (touchStartX === null) return;
				const dx = (event.changedTouches[0]?.clientX ?? touchStartX) - touchStartX;
				if (Math.abs(dx) > 40) step(dx < 0 ? 1 : -1);
				touchStartX = null;
			},
			{ signal },
		);

		/* ---------- 本地上传 ---------- */
		async function reloadLocal() {
			releaseObjectUrls();
			const ok = await loadLocalItems();
			if (!ok) return;
			photos = [...localPhotos, ...momentPhotos, ...remotePhotos];
			syncDynamicTabs();
			if (photos.length > 0) {
				finishLoading();
				render();
			}
		}

		async function addLocalPhotos(files: File[]) {
			const tags = parseTags(uploadTags?.value ?? "");
			try {
				for (const file of files) {
					await saveLocalPhoto({
						id: createLocalId("photo"),
						name: file.name,
						tags,
						blob: file,
						createdAt: Date.now(),
					});
				}
			} catch {
				note("上传失败，可能是浏览器存储空间不足");
				return;
			}
			if (signal.aborted) return;
			if (uploadTags) uploadTags.value = "";
			await reloadLocal();
			note(`已上传 ${files.length} 张照片`);
		}

		/** 把本地上传的照片导出成可发布的 Markdown + 图片（不含说说同步来的图片） */
		function exportLocalPhotos() {
			if (localItems.length === 0) {
				note("没有可导出的本地照片");
				return;
			}
			try {
				const base = sanitizeFileName("本地上传");
				const images = localItems.map((photo, index) => ({
					name: `${base}-${index + 1}.${imageExtension(photo.blob, photo.name)}`,
					blob: photo.blob,
				}));
				const relativePaths = images.map((image) => `./${image.name}`);
				const tags = Array.from(
					new Set(
						localItems
							.flatMap((photo) => photo.tags ?? [])
							.map((tag) => tag.trim())
							.filter(Boolean),
					),
				);
				const frontmatter = buildFrontmatter({
					title: "本地上传",
					date: { raw: toDateOnly(Date.now()) },
					tags,
					photos: relativePaths,
					cover: relativePaths[0],
				});
				const markdown = `${frontmatter}本地上传的照片合集。\n`;
				const { markdownName, imageCount } = downloadPublishBundle(
					markdown,
					base,
					images,
				);
				note(
					`已导出 ${markdownName} + ${imageCount} 张图片，放进 src/content/相册/本地上传/ 后重新构建即可公开`,
				);
			} catch {
				note("导出失败，请稍后重试");
			}
		}

		uploadBtn?.addEventListener("click", () => uploadInput?.click(), { signal });
		exportBtn?.addEventListener("click", exportLocalPhotos, { signal });
		uploadInput?.addEventListener(
			"change",
			() => {
				const files = Array.from(uploadInput?.files ?? []);
				if (uploadInput) uploadInput.value = "";
				const images = files.filter(isImageFile);
				if (images.length === 0) return;
				void addLocalPhotos(images);
			},
			{ signal },
		);

		/* ---------- 启动：先铺本地，图床可用时再异步追加 ---------- */
		async function boot() {
			const ok = await loadLocalItems();
			if (!ok) return;
			photos = [...localPhotos, ...momentPhotos];
			syncDynamicTabs();
			if (photos.length > 0) {
				finishLoading();
				render();
			}
			if (!bedUrl || !bedToken) {
				if (photos.length === 0) setStatus("未配置图床 API Token");
				return;
			}
			await loadRemoteItems();
			if (signal.aborted) return;
			photos = [...localPhotos, ...momentPhotos, ...remotePhotos];
			syncDynamicTabs();
			if (photos.length > 0) {
				render();
				finishLoading();
			} else {
				setStatus("图床里没有照片");
			}
		}

		syncSearchClear();
		syncTabs();
		void boot();
	}

	initAlbumPage();
	document.addEventListener("astro:page-load", initAlbumPage);
	document.addEventListener("swup:content:replaced", initAlbumPage);
	window.addEventListener("pagehide", releaseObjectUrls);
	</script>

