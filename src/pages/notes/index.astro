		/** 导出前补齐可发布的 frontmatter：缺 title / published / tags 时补上 */
		function ensurePublishableFrontmatter(raw: string, note: NoteRecord): string {
			const match = /^---\r?\n([\s\S]*?)\r?\n---\r?\n?/.exec(raw);
			if (!match) {
				return `${buildFrontmatter({
					title: note.title,
					published: { raw: toDateOnly(note.createdAt) },
					tags: note.tags,
					downloadable: { raw: "true" },
				})}\n${raw}`;
			}

			let fields = match[1];
			if (!/^published\s*:/m.test(fields)) {
				fields += `\npublished: ${toDateOnly(note.createdAt)}`;
			}
			// 笔记是唯一允许访客下载的内容；普通文章不加这个标记
			if (!/^downloadable\s*:/m.test(fields)) {
				fields += "\ndownloadable: true";
			}
			if (!/^title\s*:/m.test(fields)) {
				fields = `title: ${yamlString(note.title)}\n${fields}`;
			}
			if (!/^tags\s*:/m.test(fields) && note.tags.length > 0) {
				fields += `\ntags:\n${note.tags
					.map((tag) => `  - ${yamlString(tag)}`)
					.join("\n")}`;
			}

			return `---\n${fields}\n---\n\n${raw.slice(match[0].length)}`;
		}

		/** 导出为可发布 Markdown：连同笔记图片一起下载，图片引用改为相对路径 */
		async function exportNote(note: NoteRecord) {
			try {
				const base = sanitizeFileName(note.title || note.id);
				const stored = await listNoteImages(note.id);
				const files: ExportImage[] = [];
				let raw = note.raw;

				stored.forEach((image, index) => {
					const newName = `${base}-${index + 1}.${imageExtension(image.blob, image.name)}`;
					files.push({ name: newName, blob: image.blob });

					// 把 md 里对旧图片名的引用替换成导出的新文件名（保留原来的 ./ 前缀）
					const pattern = new RegExp(
						image.name.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"),
						"gi",
					);
					raw = raw.replace(pattern, newName);
				});

				raw = ensurePublishableFrontmatter(raw, note);

				const result = downloadPublishBundle(raw, base, files);
				toast(
					`已导出 ${result.markdownName}${
						result.imageCount > 0 ? ` + ${result.imageCount} 张图片` : ""
					}，放进 src/content/文章/ 后重新构建即可公开`,
				);
			} catch {
				toast("导出失败，请稍后重试");
			}
		}

