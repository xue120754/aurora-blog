---
import { Icon } from "astro-icon/components";
import PageTitle from "@/components/common/PageTitle.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// 流光：简约时钟 + 正计时 / 倒计时。
// 计时设置只保存在当前页面内存里，不写入任何存储，也不会修改站点内容；
// 访客只能查看页面和下载笔记（笔记是否可下载由文章 frontmatter 决定）。
---

<MainGridLayout
	title="流光"
	description="流光落雪，岁月如梭 —— 一只简约的时钟，也支持正计时与倒计时"
>
	<div class="flex w-full rounded-(--radius-large) overflow-clip relative min-h-32">
		<div class="card-base z-10 px-4 py-6 md:px-9 relative w-full">
			<div class="mb-20">
				<PageTitle
					title="流光"
					eyebrow="Time"
					description="流光落雪，岁月如梭 —— 安静地看时间走过"
					class="flow-title"
				/>
			</div>

			<section class="flowlight" id="flowlight">
				<!-- 六位数字时钟：冰蓝晶体纹理 + 中部翻页细分隔线 -->
				<div class="flow-clock" id="flow-clock" role="timer" aria-label="流光时钟">
					<div class="flow-clock__display" aria-hidden="true">
						<span class="flow-digit-pair" id="flow-hours-display">00</span>
						<span class="flow-digit-pair" id="flow-minutes-display">00</span>
						<span class="flow-digit-pair" id="flow-seconds-display">00</span>
					</div>
					<span class="sr-only" id="flow-digital">00:00:00</span>
				</div>

				<div class="flow-readout">
					<span class="flow-status" id="flow-status">时钟</span>
				</div>

				<!-- 下方：正 / 倒计时设置 -->
				<div class="flow-panel">
					<div class="flow-modes" role="group" aria-label="计时模式">
						<button type="button" class="flow-mode is-active" data-flow-mode="clock">
							时钟
						</button>
						<button type="button" class="flow-mode" data-flow-mode="up">
							正计时
						</button>
						<button type="button" class="flow-mode" data-flow-mode="down">
							倒计时
						</button>
					</div>

					<div class="flow-duration" id="flow-duration" hidden>
						<label class="flow-field">
							<span>时</span>
							<input
								id="flow-hours"
								type="number"
								min="0"
								max="99"
								step="1"
								value="0"
								inputmode="numeric"
							/>
						</label>
						<label class="flow-field">
							<span>分</span>
							<input
								id="flow-minutes"
								type="number"
								min="0"
								max="59"
								step="1"
								value="25"
								inputmode="numeric"
							/>
						</label>
						<label class="flow-field">
							<span>秒</span>
							<input
								id="flow-seconds"
								type="number"
								min="0"
								max="59"
								step="1"
								value="0"
								inputmode="numeric"
							/>
						</label>
					</div>

					<div class="flow-actions" id="flow-actions" hidden>
						<button type="button" class="notes-btn notes-btn--primary" id="flow-start">
							<Icon name="material-symbols:play-arrow-rounded" is:inline />
							<span>开始</span>
						</button>
						<button type="button" class="notes-btn" id="flow-reset">
							<Icon name="material-symbols:restart-alt-rounded" is:inline />
							<span>重置</span>
						</button>
					</div>

				</div>
			</section>
		</div>
	</div>

	<style is:global>
		.flowlight {
			max-width: 60rem;
			margin: 0 auto;
			padding: 0.25rem 0 1rem;
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 1rem;
		}

		/* ── 顶部标题与描述：在原尺寸基础上整体放大 1.5 倍 ── */
		.flow-title .page-title__eyebrow {
			font-size: 1.125rem;
		}

		.flow-title .page-title__text {
			--pt-size: clamp(2.6rem, 5.5vw, 3.4rem);
		}

		.flow-title {
			--deep-text: #a9ccd7;
		}

		.flow-title .page-title__solid {
			fill: #a9ccd7 !important;
		}

		.flow-title .page-title__ink {
			stroke: #a9ccd7 !important;
		}

		/* 顶部小字：保留原文案，加一道流动光效 */
		.flow-title .page-title__desc {
			margin-top: 0.45rem;
			font-size: 1.23rem;
			color: transparent;
			background-image: linear-gradient(
				100deg,
				var(--content-meta) 0%,
				var(--content-meta) 38%,
				var(--deep-text) 50%,
				var(--content-meta) 62%,
				var(--content-meta) 100%
			);
			background-size: 260% 100%;
			background-clip: text;
			-webkit-background-clip: text;
			animation:
				page-title-fade 0.9s ease-out 0.6s both,
				flow-title-sheen 6s linear infinite;
		}

		@keyframes flow-title-sheen {
			from {
				background-position: 130% 0;
			}
			to {
				background-position: -130% 0;
			}
		}

		/* ── 大号晶体数字时钟 ── */
		.flow-clock {
			position: relative;
			isolation: isolate;
			width: min(100%, 50rem);
			margin: 0 auto;
			overflow: hidden;
			padding: clamp(1.75rem, 5vw, 4rem) clamp(0.5rem, 2vw, 1.25rem);
			border: 1px solid rgba(180, 220, 232, 0.08);
			border-radius: clamp(1rem, 2.5vw, 1.75rem);
			/* 近乎透明：只留一层极淡的冷调雾气，避免数字糊在背景上 */
			background:
				radial-gradient(circle at 50% 40%, rgba(85, 132, 151, 0.07), transparent 62%),
				linear-gradient(145deg, rgba(6, 16, 22, 0.14), rgba(3, 9, 13, 0.2));
			box-shadow:
				inset 0 1px 0 rgba(255, 255, 255, 0.03),
				0 18px 48px rgba(0, 0, 0, 0.06);
		}

		/* 亮色主题：一层可见的暖色底，让时钟卡从浅色壁纸上浮出来 */
		html:not(.dark) .flow-clock {
			border-color: rgba(224, 186, 158, 0.38);
			background:
				radial-gradient(circle at 50% 48%, rgba(255, 214, 186, 0.2), transparent 70%),
				linear-gradient(145deg, rgba(255, 246, 238, 0.4), rgba(252, 238, 226, 0.3));
			box-shadow:
				inset 0 1px 0 rgba(255, 255, 255, 0.65),
				0 18px 48px rgba(196, 150, 120, 0.14);
		}

		.flow-clock__display {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: clamp(0.5rem, 2vw, 1.5rem);
			transform: scaleY(1.12);
		}

		.flow-digit-pair {
			position: relative;
			display: inline-block;
			padding-right: 0.06em;
			color: transparent;
			background-color: #a9ccd7;
			background-image:
				radial-gradient(circle at 20% 25%, rgba(255, 255, 255, 0.85) 0 1px, transparent 1.8px),
				radial-gradient(circle at 75% 60%, rgba(167, 224, 238, 0.65) 0 1px, transparent 2px),
				linear-gradient(115deg, transparent 0 32%, rgba(255, 255, 255, 0.42) 33%, transparent 35% 63%, rgba(255, 255, 255, 0.2) 64%, transparent 66%),
				linear-gradient(135deg, #446373 0%, #c7e3e8 22%, #6f96a8 42%, #e3f3f3 58%, #5b7e91 78%, #b5d8e1 100%);
			background-size: 47px 53px, 71px 67px, 220% 220%, 180% 180%;
			background-position: 0 0, 0 0, 0% 50%, 0% 50%;
			background-clip: text;
			-webkit-background-clip: text;
			-webkit-text-fill-color: transparent;
			font-family: "Arial Black", "Helvetica Neue", Arial, sans-serif;
			font-size: clamp(4.35rem, 15.5vw, 11.5rem);
			font-weight: 900;
			font-variant-numeric: tabular-nums;
			letter-spacing: -0.06em;
			line-height: 1;
			filter: drop-shadow(0 0.05em 0.035em rgba(0, 0, 0, 0.55)) drop-shadow(0 0 0.12em rgba(130, 205, 225, 0.16));
			animation: flow-digit-shimmer 12s ease-in-out infinite alternate;
		}

		.flow-digit-pair:nth-child(2) {
			animation-delay: -4s;
		}

		.flow-digit-pair:nth-child(3) {
			animation-delay: -8s;
		}

		/* 亮色主题：换成偏淡偏暖的暖白晶体（奶油 / 浅陶土），与浅色壁纸同一色温 */
		html:not(.dark) .flow-digit-pair {
			background-color: #d9bcaa;
			background-image:
				radial-gradient(circle at 20% 25%, rgba(255, 255, 255, 0.95) 0 1px, transparent 1.8px),
				radial-gradient(circle at 75% 60%, rgba(255, 232, 216, 0.85) 0 1px, transparent 2px),
				linear-gradient(115deg, transparent 0 32%, rgba(255, 255, 255, 0.6) 33%, transparent 35% 63%, rgba(255, 255, 255, 0.3) 64%, transparent 66%),
				linear-gradient(135deg, #a8836f 0%, #f7e6da 22%, #b99483 42%, #fff4ea 58%, #a07a67 78%, #e9cdbc 100%);
			filter: drop-shadow(0 0.045em 0.032em rgba(140, 96, 74, 0.34)) drop-shadow(0 0 0.16em rgba(240, 190, 160, 0.3));
		}

		/* 翻页钟的中缝：只保留一道细线，不分割成厚重卡片 */
		.flow-digit-pair::after {
			content: "";
			position: absolute;
			z-index: 1;
			top: 50%;
			left: -0.025em;
			right: 0;
			height: max(1px, 0.018em);
			transform: translateY(-50%);
			background: rgba(3, 10, 14, 0.76);
			box-shadow: 0 1px 0 rgba(220, 244, 248, 0.14);
		}

		@keyframes flow-digit-shimmer {
			to {
				background-position: 12px 9px, -14px 11px, 100% 50%, 100% 50%;
			}
		}

		.flowlight.is-finished .flow-clock__display {
			animation: flow-finish-pulse 1.2s ease-in-out infinite;
		}

		.flowlight.is-finished .flow-status {
			color: var(--primary);
		}

		@keyframes flow-finish-pulse {
			0%,
			100% {
				opacity: 1;
			}
			50% {
				opacity: 0.45;
			}
		}

		.flow-readout {
			display: flex;
			justify-content: center;
			margin-top: -0.35rem;
		}

		.flow-status {
			color: var(--content-meta);
			font-size: 0.9rem;
			font-weight: 700;
			letter-spacing: 0.18em;
		}

		/* ── 下方设置：整体缩小 ── */
		.flow-panel {
			width: min(100%, 25rem);
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 0.7rem;
		}

		.flow-modes {
			display: inline-flex;
			gap: 0.25rem;
			padding: 0.28rem;
			border-radius: 0.75rem;
			background: var(--btn-plain-bg-hover);
		}

		.flow-mode {
			padding: 0.5rem 1.15rem;
			border: none;
			border-radius: 0.45rem;
			background: transparent;
			color: var(--content-meta);
			font-family: inherit;
			font-size: 1.05rem;
			font-weight: 700;
			cursor: pointer;
			transition:
				background-color 0.18s ease,
				color 0.18s ease;
		}

		.flow-mode:hover {
			color: var(--deep-text);
		}

		.flow-mode.is-active {
			background: var(--deep-text);
			color: var(--page-bg);
		}

		.flow-duration {
			display: flex;
			align-items: flex-end;
			gap: 0.45rem;
		}

		.flow-duration[hidden],
		.flow-actions[hidden] {
			display: none;
		}

		.flow-field {
			display: flex;
			flex-direction: column;
			gap: 0.2rem;
			color: var(--content-meta);
			font-size: 0.62rem;
			font-weight: 600;
		}

		.flow-field input {
			width: 3.3rem;
			padding: 0.28rem 0.45rem;
			border: 1.5px solid var(--line-divider);
			border-radius: 0.5rem;
			background: transparent;
			color: var(--deep-text);
			font-family: inherit;
			font-size: 0.8rem;
			text-align: center;
			transition: border-color 0.15s ease;
		}

		.flow-field input:focus {
			outline: none;
			border-color: var(--primary);
		}

		.flow-actions {
			display: flex;
			gap: 0.5rem;
		}

		.flow-actions .notes-btn {
			padding: 0.38rem 0.85rem;
			font-size: 0.76rem;
		}


		@media (prefers-reduced-motion: reduce) {
			.flow-title .page-title__desc {
				color: var(--content-meta);
				background-image: none;
				animation: none;
			}

			.flow-digit-pair,
			.flowlight.is-finished .flow-clock__display {
				animation: none;
			}
		}
	</style>

	<script>
		let disposeFlowlight: (() => void) | null = null;

		function initFlowlight() {
			// 离开页面（Swup 导航）时先清理上一页的定时器
			if (disposeFlowlight) {
				disposeFlowlight();
				disposeFlowlight = null;
			}

			const root = document.getElementById("flowlight");
			if (!root) return;

			const hourDisplay = document.getElementById("flow-hours-display");
			const minuteDisplay = document.getElementById("flow-minutes-display");
			const secondDisplay = document.getElementById("flow-seconds-display");
			const digital = document.getElementById("flow-digital");
			const statusEl = document.getElementById("flow-status");
			const durationPanel = document.getElementById("flow-duration");
			const actions = document.getElementById("flow-actions");
			const hoursInput = document.getElementById("flow-hours") as HTMLInputElement | null;
			const minutesInput = document.getElementById("flow-minutes") as HTMLInputElement | null;
			const secondsInput = document.getElementById("flow-seconds") as HTMLInputElement | null;
			const startBtn = document.getElementById("flow-start");
			const resetBtn = document.getElementById("flow-reset");

			if (
				!hourDisplay ||
				!minuteDisplay ||
				!secondDisplay ||
				!digital ||
				!statusEl ||
				!durationPanel ||
				!actions ||
				!hoursInput ||
				!minutesInput ||
				!secondsInput ||
				!startBtn ||
				!resetBtn
			) {
				return;
			}

			const controller = new AbortController();
			const { signal } = controller;
			const timeouts = new Set<number>();

			const later = (fn: () => void, delay: number) => {
				const id = window.setTimeout(() => {
					timeouts.delete(id);
					if (!signal.aborted) fn();
				}, delay);
				timeouts.add(id);
			};

			const pad = (value: number) => String(value).padStart(2, "0");
			const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

			// ── 标题下的小字：逐步显示 / 停留 / 逐步消失，循环（与主页标语同一节奏） ──
			const descEl = document.querySelector<HTMLElement>(".flow-title .page-title__desc");
			const phrase = "流光落雪，岁月如梭 —— 安静地看时间走过";
			if (descEl) {
				if (reduceMotion) {
					descEl.textContent = phrase;
				} else {
					const chars = Array.from(phrase);
					let index = 0;
					let deleting = false;
					const tick = () => {
						index += deleting ? -1 : 1;
						descEl.textContent = chars.slice(0, index).join("");
						if (!deleting && index >= chars.length) {
							deleting = true;
							later(tick, 2600);
							return;
						}
						if (deleting && index <= 0) {
							deleting = false;
							later(tick, 800);
							return;
						}
						later(tick, deleting ? 45 : 120);
					};
					descEl.textContent = "";
					later(tick, 500);
				}
			}

			// ── 时钟 / 计时 ──
			type Mode = "clock" | "up" | "down";
			let mode: Mode = "clock";
			let running = false;
			let accumulated = 0;
			let runStartedAt = 0;
			let durationMs = 0;
			let finished = false;

			const readDuration = () => {
				const clamp = (input: HTMLInputElement, max: number) => {
					const value = Math.floor(Number(input.value) || 0);
					return Math.min(max, Math.max(0, value));
				};
				const h = clamp(hoursInput, 99);
				const m = clamp(minutesInput, 59);
				const s = clamp(secondsInput, 59);
				return (h * 3600 + m * 60 + s) * 1000;
			};

			const elapsed = (now: number) => accumulated + (running ? now - runStartedAt : 0);

			const setTime = (hours: number, minutes: number, seconds: number) => {
				const hourText = pad(hours);
				const minuteText = pad(minutes);
				const secondText = pad(seconds);
				hourDisplay.textContent = hourText;
				minuteDisplay.textContent = minuteText;
				secondDisplay.textContent = secondText;
				digital.textContent = `${hourText}:${minuteText}:${secondText}`;
			};

			const update = () => {
				const now = performance.now();

				if (mode === "clock") {
					const date = new Date();
					const hours = date.getHours();
					const minutes = date.getMinutes();
					const seconds = date.getSeconds();
					setTime(hours, minutes, seconds);
					statusEl.textContent = "时钟";
					return;
				}

				let totalMs = mode === "up" ? elapsed(now) : Math.max(0, durationMs - elapsed(now));

				if (mode === "down" && running && totalMs <= 0) {
					running = false;
					finished = true;
					accumulated = durationMs;
					totalMs = 0;
					startBtn.textContent = "重新开始";
					statusEl.textContent = "时间到";
					root.classList.add("is-finished");
				}

				const totalSeconds = Math.floor(totalMs / 1000);
				const hours = Math.floor(totalSeconds / 3600);
				const minutes = Math.floor((totalSeconds % 3600) / 60);
				const seconds = totalSeconds % 60;
				setTime(hours, minutes, seconds);
			};

			const modeButtons = Array.from(
				root.querySelectorAll<HTMLButtonElement>("[data-flow-mode]"),
			);

			const setMode = (next: Mode) => {
				mode = next;
				running = false;
				accumulated = 0;
				finished = false;
				root.classList.remove("is-finished");
				startBtn.textContent = "开始";
				durationPanel.hidden = next !== "down";
				actions.hidden = next === "clock";
				statusEl.textContent =
					next === "clock" ? "时钟" : next === "up" ? "正计时" : "倒计时";
				durationMs = next === "down" ? readDuration() : 0;
				for (const button of modeButtons) {
					button.classList.toggle("is-active", button.dataset.flowMode === next);
				}
				update();
			};

			const toggleStart = () => {
				if (mode === "clock") return;

				if (running) {
					accumulated = elapsed(performance.now());
					running = false;
					startBtn.textContent = "继续";
					statusEl.textContent = "已暂停";
					update();
					return;
				}

				if (finished) {
					accumulated = 0;
					finished = false;
					root.classList.remove("is-finished");
					durationMs = readDuration();
				}

				if (mode === "down") {
					if (!durationMs) durationMs = readDuration();
					if (durationMs <= 0) {
						statusEl.textContent = "请先设置时长";
						hoursInput.focus();
						return;
					}
					if (accumulated >= durationMs) accumulated = 0;
				}

				running = true;
				runStartedAt = performance.now();
				startBtn.textContent = "暂停";
				statusEl.textContent = mode === "up" ? "正计时" : "倒计时";
				update();
			};

			const resetTimer = () => {
				running = false;
				accumulated = 0;
				finished = false;
				root.classList.remove("is-finished");
				startBtn.textContent = "开始";
				if (mode === "down") durationMs = readDuration();
				statusEl.textContent = mode === "up" ? "正计时" : "倒计时";
				update();
			};

			for (const button of modeButtons) {
				button.addEventListener(
					"click",
					() => setMode((button.dataset.flowMode as Mode) || "clock"),
					{ signal },
				);
			}

			startBtn.addEventListener("click", toggleStart, { signal });
			resetBtn.addEventListener("click", resetTimer, { signal });

			for (const input of [hoursInput, minutesInput, secondsInput]) {
				input.addEventListener(
					"change",
					() => {
						if (mode === "down" && !running && accumulated === 0) {
							durationMs = readDuration();
							update();
						}
					},
					{ signal },
				);
				input.addEventListener(
					"blur",
					() => {
						const max = input === hoursInput ? 99 : 59;
						const value = Math.floor(Number(input.value) || 0);
						input.value = String(Math.min(max, Math.max(0, value)));
					},
					{ signal },
				);
			}

			// 100ms 刷新：保证时钟与正 / 倒计时显示及时更新
			const tickId = window.setInterval(update, 100);
			update();

			disposeFlowlight = () => {
				controller.abort();
				window.clearInterval(tickId);
				for (const id of timeouts) window.clearTimeout(id);
				timeouts.clear();
			};
		}

		initFlowlight();
		document.addEventListener("astro:page-load", initFlowlight);
		document.addEventListener("swup:content:replaced", initFlowlight);
	</script>
</MainGridLayout>
